# ==============================================================================
# KORTEX.AI — BACKEND & MCP BRIDGE ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Single-Owner Access Security (Optional in dev mode, recommended in production)
# If left empty, the server operates in local dev mode.
OWNER_TOKEN=

# AI Provider Configuration (Processed strictly on the server, never sent to frontend)
# Supported providers: openai, openrouter, anthropic, gemini, ollama, custom
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Ollama example (local):
# AI_PROVIDER=ollama
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=

# OpenRouter example:
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-3.5-sonnet
# AI_API_KEY=

# MCP Bridge Configuration
MCP_SERVERS_FILE=./data/mcp-servers.json
